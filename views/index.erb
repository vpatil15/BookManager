<div style="text-align: center; margin-bottom: 30px;">
  <h2>📖 Your Book Collection</h2>
  <p style="color: #7f8c8d; font-size: 1.1em;">Manage and explore your personal library</p>
  <a href="/books/new" class="btn" style="margin-top: 15px;">➕ Add Your First Book</a>
</div>

<% if @books.any? %>
  <table>
    <tr>
      <th>📚 Title</th>
      <th>✍️ Author</th>
      <th>🛠️ Actions</th>
    </tr>
    <% @books.each do |book| %>
      <tr>
        <td><strong><%= book.title %></strong></td>
        <td><%= book.author %></td>
        <td class="action-links">
          <a href="/books/<%= book.id %>" class="btn" style="background: linear-gradient(135deg, #27ae60, #2ecc71);">👁️ View</a>
          <a href="/books/<%= book.id %>/edit" class="btn" style="background: linear-gradient(135deg, #f39c12, #e67e22);">✏️ Edit</a>
          <form action="/books/<%= book.id %>/delete" method="post" style="display:inline;">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?')">🗑️ Delete</button>
          </form>
        </td>
      </tr>
    <% end %>
  </table>
<% else %>
  <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <h3 style="color: #7f8c8d; margin-bottom: 20px;">📚 No Books Yet!</h3>
    <p style="color: #95a5a6; margin-bottom: 30px;">Start building your digital library by adding your first book.</p>
    <a href="/books/new" class="btn" style="font-size: 1.2em; padding: 15px 30px;">➕ Add Your First Book</a>
  </div>
<% end %>
