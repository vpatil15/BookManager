<div style="max-width: 800px; margin: 0 auto;">
  <div class="book-card" style="margin-bottom: 30px;">
    <h2 style="color: #2c3e50; margin-bottom: 20px;">📖 <%= @book.title %></h2>
    <div style="background: #ecf0f1; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
      <strong>✍️ Author:</strong> <%= @book.author %>
    </div>
    <% if @book.description && !@book.description.empty? %>
      <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
        <strong>📝 Description:</strong><br>
        <p style="margin-top: 10px; line-height: 1.6;"><%= @book.description %></p>
      </div>
    <% end %>
    <div style="text-align: center; margin-top: 30px;">
      <a href="/books/<%= @book.id %>/edit" class="btn" style="background: linear-gradient(135deg, #f39c12, #e67e22);">✏️ Edit Book</a>
      <a href="/" class="btn" style="background: linear-gradient(135deg, #3498db, #2980b9); margin-left: 10px;">🏠 Back to Library</a>
      <form action="/books/<%= @book.id %>/delete" method="post" style="display: inline; margin-left: 10px;">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?')">🗑️ Delete Book</button>
      </form>
    </div>
  </div>
</div>
