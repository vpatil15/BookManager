<div style="max-width: 600px; margin: 0 auto;">
  <h2 style="text-align: center; color: #2c3e50; margin-bottom: 30px;">📚 Add New Book to Your Collection</h2>
  <form action="/books" method="post">
    <label>📖 Book Title:
      <input type="text" name="title" required placeholder="Enter the book title">
    </label>
    <label>✍️ Author:
      <input type="text" name="author" required placeholder="Enter the author's name">
    </label>
    <label>📝 Description:
      <textarea name="description" placeholder="Write a brief description or your thoughts about this book..."></textarea>
    </label>
    <div style="text-align: center;">
      <button type="submit" style="font-size: 1.1em; padding: 15px 30px;">📚 Add Book</button>
      <a href="/" class="btn" style="background: linear-gradient(135deg, #95a5a6, #7f8c8d); margin-left: 10px;">Cancel</a>
    </div>
  </form>
</div>
