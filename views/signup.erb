<div style="max-width: 400px; margin: 0 auto;">
  <h2 style="text-align: center; color: #2c3e50; margin-bottom: 30px;">📝 Join Our Community!</h2>
  <form action="/signup" method="post">
    <label>👤 Choose Username:
      <input type="text" name="username" required placeholder="Pick a unique username">
    </label>
    <label>🔐 Create Password:
      <input type="password" name="password" required placeholder="Create a secure password">
    </label>
    <button type="submit" style="width: 100%; font-size: 1.1em; padding: 15px;">🎉 Create Account</button>
  </form>
  <div style="text-align: center; margin-top: 20px; color: #7f8c8d;">
    Already have an account? <a href="/login" style="color: #3498db; font-weight: bold;">Login here</a>
  </div>
</div>
